# Control de ficheros
# Se pretende crear algunas funciones de gestión de ficheros.
# Por ejemplo una para borrar múltiples ficheros al tiempo que
# de paso borre de la base de datos todas las referencias a 
# esos ficheros.
function files.browse() {
    local cols=$(tput cols)
    local rows=$(tput lines)
    local brow=3
    local erow=10

    tput clear
    tput cup 2 5
    tput bold
    local files=( * )
    echo "Navegador de ficheros - ${#files[@]} ficheros"
    tput sgr0
    tput cup $(tput lines) 0
    #tput cup $erow 0
    pause
}
